{
  "name": "opencode-go-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "在 Vercel 上中转 OpenCode Go，供 Cursor 等受 SSRF 限制的客户端使用",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:dist": "tsc -p tsconfig.build.json",
    "verify": "npm run build:dist && node dist/scripts/verify.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
