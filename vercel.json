{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/v1/:path*" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/__health", "destination": "/api/health" }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  }
}
